# ── Turso (cloud SQLite) ─────────────────────────────────────────────────────
# Get these from https://turso.tech → your database → "Generate Token"
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── WhatsApp Business API (Meta) ─────────────────────────────────────────────
# From https://developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Gmail: Google Account → Security → 2FA on → App Passwords → generate one
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM_NAME=Calendar App

# ── Cron job security ────────────────────────────────────────────────────────
# Any random string — Vercel uses this to authenticate scheduled job calls
CRON_SECRET=replace-with-any-random-string
